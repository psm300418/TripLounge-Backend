NODE_ENV=development
PORT=3002
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
CLIENT_ORIGIN=http://localhost:5173
# Supabase 인증 리다이렉트 목록에 동일하게 등록할 URL임.
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
# 비밀키 생성 명령은 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 임.
AUTH_COOKIE_SECRET=replace-with-64-hex-characters
