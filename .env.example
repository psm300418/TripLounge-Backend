NODE_ENV=development
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
CLIENT_ORIGIN=http://localhost:3000
# Backend API: localhost:3001. Set the following callback to your separate frontend.
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_COOKIE_SECRET=replace-with-64-hex-characters

# One-time setup only: npm run auth:setup. Never commit actual values.
# Supabase account Personal Access Token, NOT anon/service_role key.
SUPABASE_ACCESS_TOKEN=
# Google OAuth Web application credentials, NOT a general Google API key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao REST API key, NOT JavaScript key or Admin key. Enable Client Secret.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# auth:setup always allows Kakao accounts without email; only nickname/photo are requested.
# Set true only after configuring Apple in Supabase Dashboard.
AUTH_APPLE_ENABLED=false
