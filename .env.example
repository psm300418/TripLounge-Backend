NODE_ENV=development
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
CLIENT_ORIGIN=http://localhost:3000
# 백엔드는 localhost:3001이며 아래 콜백은 별도 프런트 주소로 지정하는 설정임.
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
# 비밀키 생성 명령은 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 임.
AUTH_COOKIE_SECRET=replace-with-64-hex-characters

# npm run auth:setup 실행용 초기 설정이며 실제 값의 커밋은 금지임.
# anon·service_role 키가 아닌 Supabase 계정의 개인 액세스 토큰임.
SUPABASE_ACCESS_TOKEN=
# 일반 API 키가 아닌 Google OAuth 웹 애플리케이션 인증 정보임.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JavaScript·Admin 키가 아닌 카카오 REST API 키이며 Client Secret 활성화가 필수임.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오는 이메일 없이 가입 가능하며 닉네임·사진만 요청하는 설정임.
# Supabase에서 Apple 설정을 마친 뒤에만 true로 변경하는 값임.
AUTH_APPLE_ENABLED=false
